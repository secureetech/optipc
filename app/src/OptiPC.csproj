<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OptiPC</AssemblyName>
    <RootNamespace>OptiPC</RootNamespace>
    <ApplicationIcon>assets\optipc.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <Company>H2OCONSULTING - FZCO</Company>
    <Product>OptiPC</Product>
    <Description>OptiPC - Optimisation et protection du PC</Description>
    <Copyright>SecureeTech</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.VisualBasic" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ui\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="engine\**\*.ps1" LogicalName="engine/%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets\optipc.ico" LogicalName="assets/optipc.ico" />
  </ItemGroup>
  <!-- Bibliotheques WebView2 incluses dans l'exe (un seul fichier a distribuer) -->
  <Target Name="EmbedWebView2" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <WV2Dir>$(NuGetPackageRoot)microsoft.web.webview2/1.0.2903.40/</WV2Dir>
    </PropertyGroup>
    <ItemGroup>
      <EmbeddedResource Include="$(WV2Dir)lib/net462/Microsoft.Web.WebView2.Core.dll" LogicalName="deps/Microsoft.Web.WebView2.Core.dll" />
      <EmbeddedResource Include="$(WV2Dir)lib/net462/Microsoft.Web.WebView2.WinForms.dll" LogicalName="deps/Microsoft.Web.WebView2.WinForms.dll" />
      <EmbeddedResource Include="$(WV2Dir)runtimes/win-x64/native/WebView2Loader.dll" LogicalName="deps/WebView2Loader.dll" />
    </ItemGroup>
  </Target>
  <ItemGroup>
  </ItemGroup>
</Project>
